# Database (SQLite file, local to the project)
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"

# Used only by `npm run seed` to create the first manager account
SEED_MANAGER_NAME="Admin"
SEED_MANAGER_EMAIL="admin@example.com"
SEED_MANAGER_PASSWORD="change-me-now"

# Google Drive backup (optional — leave both unset to disable; see the
# "Google Drive backup" section in README.md for the one-time setup)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_DRIVE_ROOT_FOLDER_ID="the-shared-folder-id-from-its-drive-url"
